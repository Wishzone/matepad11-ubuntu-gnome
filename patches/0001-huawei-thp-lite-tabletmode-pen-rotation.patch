 /* thp_mt_wrapper_ioctl_report_pen() / thp_report_pen_event() */
+static void thp_rotate_pen(struct thp *t, int *x, int *y)
+{
+	long long u = (long long)*x * 10000 / THP_PEN_MAX_X;
+	long long v = (long long)*y * 10000 / THP_PEN_MAX_Y;
+	long long u2, v2;
+
+	if (u < 0)
+		u = 0;
+	if (u > 10000)
+		u = 10000;
+	if (v < 0)
+		v = 0;
+	if (v > 10000)
+		v = 10000;
+
+	switch (t->rotation) {
+	case 1:		/* 90 degrees clockwise */
+		u2 = 10000 - v;
+		v2 = u;
+		break;
+	case 2:		/* 180 degrees */
+		u2 = 10000 - u;
+		v2 = 10000 - v;
+		break;
+	case 3:		/* 90 degrees counter-clockwise */
+		u2 = v;
+		v2 = 10000 - u;
+		break;
+	default:
+		u2 = u;
+		v2 = v;
+		break;
+	}
+
+	*x = u2 * THP_PEN_MAX_X / 10000;
+	*y = v2 * THP_PEN_MAX_Y / 10000;
+}
