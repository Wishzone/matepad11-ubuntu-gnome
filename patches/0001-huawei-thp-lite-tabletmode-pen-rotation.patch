+/*
+ * Current display orientation, written by matepad-volkeys:
+ * 0 = right-up (default landscape), 1 = 90 CW, 2 = 180, 3 = 90 CCW.
+ * The finger coordinates are transformed by Mutter, but the M-Pencil is a
+ * tablet tool and Mutter does not apply the output transform to it, so the
+ * pen is rotated here.
+ */
+static ssize_t rotation_show(struct device *dev,
+			     struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", g_thp->rotation);
+}
+
+static ssize_t rotation_store(struct device *dev,
+			      struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	unsigned int v;
+
+	if (kstrtouint(buf, 10, &v) || v > 3)
+		return -EINVAL;
+	g_thp->rotation = v;
+	return count;
+}
+static DEVICE_ATTR_RW(rotation);
