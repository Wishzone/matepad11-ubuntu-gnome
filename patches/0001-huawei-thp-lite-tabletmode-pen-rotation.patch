+/*
+ * Mutter only enables auto-rotation when it sees a SW_TABLET_MODE switch.
+ * The keyboard-dock hall sensor is disabled in the DT (rotation must keep
+ * working with the magnetic keyboard attached), so provide a switch that
+ * always reports tablet mode.
+ */
+static int thp_tabletmode_register(struct thp *t)
+{
+	struct input_dev *sw;
+	int ret;
+
+	sw = devm_input_allocate_device(&t->spi->dev);
+	if (!sw)
+		return -ENOMEM;
+	sw->name = "matepad-tabletmode";
+	__set_bit(EV_SW, sw->evbit);
+	__set_bit(SW_TABLET_MODE, sw->swbit);
+	t->tabletmode = sw;
+
+	ret = input_register_device(sw);
+	if (ret)
+		return ret;
+
+	input_report_switch(sw, SW_TABLET_MODE, 1);
+	input_sync(sw);
+	return 0;
+}
