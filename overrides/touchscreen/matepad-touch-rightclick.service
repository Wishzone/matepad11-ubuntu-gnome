[Unit]
Description=MatePad touchscreen right-click gestures
After=display-manager.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe uinput
ExecStart=/usr/local/sbin/matepad-touch-rightclick
Restart=on-failure
RestartSec=1
Nice=-2

[Install]
WantedBy=graphical.target
